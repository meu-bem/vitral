{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exceções datadas (data/calendario/excecoes.yaml)",
  "type": "object",
  "required": ["excecoes"],
  "additionalProperties": false,
  "properties": {
    "excecoes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["celebracao", "data_propria", "nova_data", "fontes"],
        "additionalProperties": false,
        "properties": {
          "celebracao": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "data_propria": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "nova_data": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "fontes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "observacao": {"type": "string"}
        }
      }
    }
  }
}
