{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Links estáveis (data/links.yaml)",
  "type": "object",
  "required": ["links"],
  "additionalProperties": false,
  "properties": {
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "titulo", "url", "tipo", "verificado_em"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "titulo": {"type": "string", "minLength": 3},
          "url": {"type": "string", "pattern": "^https://"},
          "tipo": {"enum": ["liturgia-diaria", "comentario", "biblia", "calendario"]},
          "responsavel": {"type": "string"},
          "verificado_em": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "observacao": {"type": "string"}
        }
      }
    }
  }
}
